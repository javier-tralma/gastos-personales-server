NODE_ENV=production
PORT=3000

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-strong-32-byte-secret
BETTER_AUTH_URL=https://your-render-service.onrender.com

# PostgreSQL/Neon runtime database.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=verify-full
POSTGRES_DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=verify-full

# Frontend deployed separately, for example on Vercel.
FRONTEND_URL=https://your-vercel-app.vercel.app
CORS_ORIGIN=https://your-vercel-app.vercel.app

DRIZZLE_MIGRATIONS_FOLDER=./drizzle-pg
