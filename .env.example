NODE_ENV=development
PORT=3000

# Better Auth
# Generate a strong value with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-32-byte-secret
BETTER_AUTH_URL=http://127.0.0.1:3000

# PostgreSQL/Neon. Use the pooled Neon connection string when deploying
# from serverless environments; Render web services can use either pooled or direct.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=verify-full
POSTGRES_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=verify-full

# Frontend origins allowed to call the API with cookies.
FRONTEND_URL=http://127.0.0.1:5173,http://localhost:5173
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# Optional. Useful if the app is started from a cwd outside backend/.
# DRIZZLE_MIGRATIONS_FOLDER=./drizzle-pg
